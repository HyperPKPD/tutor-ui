{
  "id": "/tutor/",
  "name": "HyperPKPD Tutor",
  "short_name": "HyperPKPD",
  "description": "Free interactive tutor for population PK (1–3 compartment, TMDD) and exposure–response (linear, log-linear, Emax, Hill, hockey-stick) with equations and quizzes.",
